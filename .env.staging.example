# ================================================
# CAS Website - STAGING Environment
# ================================================
# Copy to `.env` on the staging server and fill in the values.
# Staging uses the SAME keys/values as production.
# The ONLY difference between staging and production is VITE_ENVIRONMENT.

# --- The one setting that makes this "staging" ---
# BUILD-TIME ONLY: pass this to the build (e.g. Docker --build-arg VITE_ENVIRONMENT=staging).
# Setting it at runtime does nothing. This is what shows the staging-only
# pages, homepage map, and nav items.
VITE_ENVIRONMENT=staging

# --- Runtime values (same as production) ---
NODE_ENV=production
PORT=5000

DATABASE_URL=postgresql://username:password@host:port/database

ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_ORG_ID=900159811

SESSION_SECRET=your-session-secret
AUTOMATION_API_KEY=your-automation-api-key

# --- Optional ---
# EVENT_ADMIN_USERNAME=cannAdmin
# EVENT_ADMIN_PASSWORD=Townhall2025!

# NOTE: Because staging uses production keys, any test submission on staging
# writes to the production database and creates real leads in the live Zoho CRM.
# Remember to clean up test data afterwards.
