# ================================================
# CAS Website - STAGING Environment Template
# ================================================
# Copy this file to `.env` ON THE STAGING SERVER ONLY and fill in real values.
# NEVER commit a real `.env` (with secrets) to version control!
#
# PURPOSE: staging is a safe place to test. Its database and Zoho CRM should be
# SEPARATE from production so test submissions never touch live member data.

# ================================================
# Frontend Environment Flag (BUILD-TIME ONLY)
# ================================================
# IMPORTANT: VITE_ENVIRONMENT is baked into the frontend AT BUILD TIME.
# Setting it here at runtime does NOTHING. It must be passed to the build,
# e.g. Docker:  --build-arg VITE_ENVIRONMENT=staging
# `staging` (or unset) => staging-only pages/map/nav are VISIBLE.
# `production`          => those are hidden.
VITE_ENVIRONMENT=staging

# ================================================
# Node Environment
# ================================================
# Staging is still a real deployed server, so keep this as production.
# The staging-vs-production feature difference is controlled ONLY by
# VITE_ENVIRONMENT above, NOT by NODE_ENV.
NODE_ENV=production
PORT=5000

# ================================================
# Database Configuration (PostgreSQL)
# ================================================
# Use a SEPARATE staging database — do NOT point this at production.
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@host:port/cas_staging_db

# ================================================
# Zoho CRM Integration
# ================================================
# DECISION REQUIRED — pick one:
#  (A) Point at a Zoho SANDBOX / separate org so test leads never hit the live CRM.
#  (B) Leave these UNSET for UI-only testing: submissions still save to the
#      staging database (local-first) but will not sync to any CRM.
# Do NOT reuse production Zoho credentials, or test submissions will create
# real Leads in the live CRM.
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_ORG_ID=your-staging-or-sandbox-org-id

# Optional: Custom OAuth scopes (comma-separated)
# ZOHO_OAUTH_SCOPES=ZohoCRM.modules.ALL,ZohoCRM.settings.ALL

# ================================================
# Session & Security
# ================================================
# Generate a fresh secret for staging (do not reuse production's).
# Use: openssl rand -base64 32
SESSION_SECRET=generate-a-separate-staging-session-secret

# API key for automation endpoints (use a staging-only value).
AUTOMATION_API_KEY=staging-automation-api-key

# ================================================
# Event Admin Portal (/eventsdownload)
# ================================================
# Staging-only admin credentials for the event registration dashboard.
EVENT_ADMIN_USERNAME=cannAdmin
EVENT_ADMIN_PASSWORD=change-me-for-staging

# ================================================
# Email Notifications (Optional)
# ================================================
# Usually LEAVE OFF on staging so it doesn't send real emails.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# NOTIFICATION_EMAILS=admin@amyloid.ca
# NOTIFICATIONS_ENABLED=false

# ================================================
# NOT needed on git/AWS staging
# ================================================
# These are auto-set by Replit only and are irrelevant to a git-based
# staging deployment. Leave them unset.
# REPLIT_DEPLOYMENT=1
# REPL_ID=your-repl-id

# ================================================
# Staging Setup Checklist
# ================================================
# 1. Build the frontend with VITE_ENVIRONMENT=staging (build arg, not runtime).
# 2. Copy this file to `.env` on the staging server and fill in real values.
# 3. Use a SEPARATE staging database (DATABASE_URL).
# 4. Point Zoho at a sandbox/separate org, OR leave Zoho vars unset.
# 5. Generate a fresh SESSION_SECRET (openssl rand -base64 32).
# 6. Verify: on the staging URL the homepage map and /upload-resource page
#    should be VISIBLE — that confirms VITE_ENVIRONMENT=staging was applied.
