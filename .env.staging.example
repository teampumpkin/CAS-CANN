# Staging uses the same values as production.
# Only difference: VITE_ENVIRONMENT (build-time arg, e.g. --build-arg VITE_ENVIRONMENT=staging)
#
# NOTE: On Replit most of these live in Secrets, not the .env file.
# On git/AWS staging there are no Replit Secrets, so ALL of them must be set here.

# Build-time (frontend)
VITE_ENVIRONMENT=staging
VITE_AUTOMATION_API_KEY=your-automation-api-key

# Runtime
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://username:password@host:port/database
AUTOMATION_API_KEY=your-automation-api-key

# Zoho CRM (Self Client pair is the one used for OAuth)
ZOHO_SELF_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_SELF_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_ORG_ID=900159811
# ZOHO_OAUTH_SCOPES=ZohoCRM.modules.ALL,ZohoCRM.settings.ALL

# Admin portals
EVENT_ADMIN_USERNAME=cannAdmin
EVENT_ADMIN_PASSWORD=your-event-admin-password
CONSENT_ADMIN_USERNAME=your-consent-admin-username
CONSENT_ADMIN_PASSWORD=your-consent-admin-password

# Email notifications (optional)
# NOTIFICATION_EMAILS=admin@amyloid.ca
# NOTIFICATIONS_ENABLED=false
# WEEKLY_REPORTS_ENABLED=false
# REAL_TIME_ALERTS_ENABLED=false
